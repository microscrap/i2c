{
    "name": "microscrap/i2c",
    "description": "Unix libi2c Bindings for The PHP Posi Extension",
    "type": "library",
    "version": "0.7.0",
    "keywords": [
        "framework",
        "scrapyard-io",
        "i2c",
        "smbus",
        "posi",
        "bindings"
    ],
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/i2c/0.7.x/overview",
    "support": {
        "docs": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/i2c/0.7.x/overview",
        "source": "https://github.com/microscrap/i2c",
        "issues": "https://github.com/microscrap/i2c/issues"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-posi": "^0.7.0",
        "microscrap/posix": "^0.7.0"
    },
    "suggest": {
        "scrapyard-io/gpio-framework": "GPIO application framework over Microscrap protocol bindings (^0.7)"
    },
    "autoload": {
        "psr-4": {
            "Microscrap\\Bindings\\I2C\\": "src/"
        },
        "files": [
            "src/Helpers/i2c-bus.php",
            "src/Helpers/i2c-smbus.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.7.x-dev",
            "dev-main": "0.7.x-dev",
            "dev-0.7.x": "0.7.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
