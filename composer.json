{
    "name": "microscrap/i2c",
    "description": "Unix libi2c Bindings for The PHP Posi Extension",
    "type": "library",
    "version": "0.4.0",
    "keywords": ["framework", "scrapyard-io"],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-posi": "^0.4.0",
        "microscrap/posix": "^0.4.0"
    },
    "autoload": {
        "psr-4": {
            "Microscrap\\Bindings\\I2C\\": "src/"
        },
        "files": [
            "src/Helpers/i2c-bus.php",
            "src/Helpers/i2c-smbus.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
